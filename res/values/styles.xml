<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme API 15+ (Holo) -->
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#ff000000</item>
        <item name="android:colorPrimary">#ff6200ee</item>
        <item name="android:colorPrimaryDark">#ff6200ee</item>
        <item name="android:colorAccent">#ffff3d00</item>
    </style>

    <!-- Dark theme variant -->
    <style name="DarkTheme" parent="@android:style/Theme.Holo">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#ff000000</item>
    </style>

    <style name="DarkTheme.NoActionBar" parent="@style/DarkTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="DarkTheme.NoActionBar.Fullscreen" parent="@style/DarkTheme.NoActionBar">
    </style>

    <!-- Theme aliases -->
    <style name="AppTheme.NoActionBar" parent="@style/DarkTheme.NoActionBar">
    </style>

    <style name="AppTheme.NoActionBar.Fullscreen" parent="@style/DarkTheme.NoActionBar.Fullscreen">
    </style>
</resources>
