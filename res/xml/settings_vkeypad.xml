<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:emu="http://schemas.fastemulator.com/emu">
    <CheckBoxPreference android:title="@string/enable_vibrator" android:key="enableVibrator" android:defaultValue="false" />
    <CheckBoxPreference android:title="@string/dpad_4way" android:key="dpad4Way" />
    <CheckBoxPreference android:title="@string/ab_button_press" android:key="abButtonPress" android:summary="@string/ab_button_press_summary" />
    <com.fastemulator.gba.settings.SeekBarPreference android:title="@string/controls_sensitivity" android:key="controlsSensitivity" android:summary="@string/controls_sensitivity_summary" android:defaultValue="7" emu:maxValue="10" />
    <CheckBoxPreference android:title="@string/hide_controls" android:key="hideControls" android:disableDependentsState="true" />
    <com.fastemulator.gba.settings.SeekBarPreference android:title="@string/controls_transparency" android:key="controlsTransparency" android:dependency="hideControls" android:defaultValue="0" emu:maxValue="10" />
    <PreferenceScreen android:title="@string/controls_layout" android:key="controlsLayout" />
</PreferenceScreen>
