<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material theme API 21+ (Lollipop) -->
    <style name="AppTheme.Material" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#ff000000</item>
        <item name="android:colorPrimary">#ff6200ee</item>
        <item name="android:colorPrimaryDark">#ffbf360c</item>
        <item name="android:colorAccent">#ffff3d00</item>
    </style>

    <!-- Dark Material theme -->
    <style name="DarkTheme.Material" parent="@android:style/Theme.Material">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#ff000000</item>
    </style>

    <style name="DarkTheme.Material.NoActionBar" parent="@style/DarkTheme.Material">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="DarkTheme.Material.NoActionBar.Fullscreen" parent="@style/DarkTheme.Material.NoActionBar">
    </style>
</resources>
