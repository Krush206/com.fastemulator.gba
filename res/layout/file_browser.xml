<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:fitsSystemWindows="true">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText android:id="@id/path" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1.0" android:inputType="text" android:imeOptions="actionGo" />
        <ImageButton android:id="@id/parent_dir" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/ic_btn_up_dir" android:layout_weight="0.0" />
        <ImageButton android:id="@id/menu_settings" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_preferences" android:layout_weight="0.0" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0">
        <ListView android:id="@android:id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:textFilterEnabled="true" android:fastScrollEnabled="true" />
        <TextView android:gravity="center" android:id="@android:id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/error_listing_files" />
    </FrameLayout>
</LinearLayout>
